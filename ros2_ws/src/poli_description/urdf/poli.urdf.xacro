<?xml version="1.0"?>
<!--
  POLI 로봇 위치 모델 (조원 A 초안, 2026-09-30)

  좌표 규칙 (ROS REP-103): x = 정면, y = 왼쪽, z = 위. 각도는 라디안.
  base_link 원점 = 좌우 구동 바퀴 축의 가운데 (바퀴 중심 높이).
  센서 높이는 "지면에서 몇 m"로 적으면 base_link 기준으로 자동 환산된다.

  아래 property의 값 대부분은 실측 전 값이다.
    TODO_MEASURE = 조립 후 반드시 실측해서 고칠 값
    SIM_ONLY     = 시뮬레이션·화면 확인용 임시값 (실기에 그대로 쓰지 말 것)
  바퀴 반지름·간격은 poli_hardware/config/hardware.yaml과 같은 값을 쓴다.

  출처: docs/hardware_reference.md, docs/pin_map.md, docs/mission_strategy.md
-->
<robot name="poli" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== 차체 ===== -->
  <xacro:property name="wheel_radius" value="0.0325"/>       <!-- 65 mm 바퀴. 주행 시험으로 보정 (TODO_MEASURE) -->
  <xacro:property name="wheel_width" value="0.027"/>         <!-- SIM_ONLY -->
  <xacro:property name="wheel_separation" value="0.18"/>     <!-- 좌우 바퀴 중심 간 거리 (TODO_MEASURE, hardware.yaml과 같게) -->
  <xacro:property name="body_length" value="0.20"/>          <!-- 집게 제외 차체 길이 (TODO_MEASURE) -->
  <xacro:property name="body_width" value="0.22"/>           <!-- 외곽 폭 220 mm (집게 연 상태 제공값) -->
  <xacro:property name="body_bottom_h" value="0.02"/>        <!-- 차체 바닥의 지면 높이 (TODO_MEASURE) -->
  <xacro:property name="body_top_h" value="0.14"/>           <!-- 차체 윗면의 지면 높이 (TODO_MEASURE) -->
  <xacro:property name="body_center_x" value="0.0"/>         <!-- 바퀴 축 기준 차체 중심 앞뒤 위치 (TODO_MEASURE) -->
  <xacro:property name="caster_x" value="-0.08"/>            <!-- 뒤 지지점(캐스터) 위치 (TODO_MEASURE) -->

  <!-- ===== LiDAR (RPLIDAR C1) =====
       laser 높이 = 장착면 높이 + 0.0298. 외벽·장애물(0.20 m)보다 낮아야 한다.
       frame 이름 'laser'는 sllidar_ros2 기본값·poli_navigation fake_scan과 같다. -->
  <xacro:property name="lidar_x" value="0.0"/>               <!-- TODO_MEASURE (scan_to_grid.py LASER_OFFSET과 맞출 것) -->
  <xacro:property name="lidar_y" value="0.0"/>               <!-- TODO_MEASURE -->
  <xacro:property name="lidar_mount_h" value="${body_top_h}"/>  <!-- 장착면 지면 높이 (TODO_MEASURE) -->
  <xacro:property name="lidar_yaw" value="0.0"/>             <!-- 스캔 0도 방향이 정면이 되게 (TODO_MEASURE) -->

  <!-- ===== IMU (RRC Lite 내장 QMI8658) ===== -->
  <xacro:property name="imu_x" value="0.0"/>                 <!-- RRC Lite 보드 위치 (TODO_MEASURE) -->
  <xacro:property name="imu_y" value="0.0"/>                 <!-- TODO_MEASURE -->
  <xacro:property name="imu_h" value="0.05"/>                <!-- SIM_ONLY -->
  <xacro:property name="imu_yaw" value="0.0"/>               <!-- 보드 방향. 2026-10-06 보드 단독: 반시계 = +gz 확인. 장착 방향에 따라 재확인 (TODO_MEASURE) -->

  <!-- ===== 카메라 (Raspberry Pi AI Camera, CAM0) ===== -->
  <xacro:property name="camera_x" value="0.09"/>             <!-- SIM_ONLY -->
  <xacro:property name="camera_h" value="0.12"/>             <!-- SIM_ONLY -->
  <xacro:property name="camera_pitch" value="0.26"/>         <!-- 아래로 숙인 각 (약 15도, SIM_ONLY) -->

  <!-- ===== 초음파 HC-SR04 x4 (docs/pin_map.md) =====
       frame의 +x = 센서가 보는 방향 (sensor_msgs/Range 규칙).
       전방·우측·후방은 지면에서 약 0.14 m, 좌측만 낮게 단다 (2026-09-30 결정). -->
  <xacro:property name="us_h" value="0.14"/>                 <!-- 전방·우측·후방 높이, 약 14 cm (TODO_MEASURE) -->
  <xacro:property name="us_left_h" value="0.05"/>            <!-- 좌측 센서 높이, "낮게" (TODO_MEASURE) -->
  <xacro:property name="us_front_x" value="${body_center_x + body_length / 2}"/>
  <xacro:property name="us_rear_x" value="${body_center_x - body_length / 2}"/>
  <xacro:property name="us_side_x" value="0.0"/>             <!-- 좌·우 센서 앞뒤 위치 (TODO_MEASURE) -->
  <xacro:property name="us_side_y" value="${body_width / 2}"/>

  <!-- ===== 집게 (Byte Robot Claw 125mm, 들어 올리기 없음) ===== -->
  <xacro:property name="gripper_x" value="${body_center_x + body_length / 2 + 0.03}"/>  <!-- SIM_ONLY -->
  <xacro:property name="gripper_h" value="0.05"/>            <!-- SIM_ONLY -->

  <material name="dark"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="blue"><color rgba="0.2 0.4 0.8 1.0"/></material>
  <material name="orange"><color rgba="1.0 0.5 0.1 1.0"/></material>

  <!-- ===== 링크 ===== -->
  <link name="base_link"/>

  <link name="chassis_link">
    <visual>
      <geometry><box size="${body_length} ${body_width} ${body_top_h - body_bottom_h}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="${body_length} ${body_width} ${body_top_h - body_bottom_h}"/></geometry>
    </collision>
  </link>
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="${body_center_x} 0 ${(body_top_h + body_bottom_h) / 2 - wheel_radius}"/>
  </joint>

  <!-- 바퀴: 화면 표시용 고정 joint (회전 상태는 발행하지 않음) -->
  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark"/>
      </visual>
    </link>
    <joint name="${side}_wheel_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel side="left" y="${wheel_separation / 2}"/>
  <xacro:wheel side="right" y="${-wheel_separation / 2}"/>

  <link name="caster_link">
    <visual>
      <geometry><sphere radius="0.01"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 ${0.01 - wheel_radius}"/>
  </joint>

  <link name="laser">
    <visual>
      <origin xyz="0 0 -0.0152"/>
      <geometry><cylinder radius="0.0278" length="0.0413"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_mount_h + 0.0298 - wheel_radius}" rpy="0 0 ${lidar_yaw}"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_h - wheel_radius}" rpy="0 0 ${imu_yaw}"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.01 0.025 0.024"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} 0 ${camera_h - wheel_radius}" rpy="0 ${camera_pitch} 0"/>
  </joint>

  <xacro:macro name="ultrasonic" params="name x y h yaw">
    <link name="ultrasonic_${name}_link">
      <visual>
        <geometry><box size="0.015 0.045 0.02"/></geometry>
        <material name="orange"/>
      </visual>
    </link>
    <joint name="ultrasonic_${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="ultrasonic_${name}_link"/>
      <origin xyz="${x} ${y} ${h - wheel_radius}" rpy="0 0 ${yaw}"/>
    </joint>
  </xacro:macro>
  <xacro:ultrasonic name="front" x="${us_front_x}" y="0" h="${us_h}" yaw="0"/>
  <xacro:ultrasonic name="left" x="${us_side_x}" y="${us_side_y}" h="${us_left_h}" yaw="${pi / 2}"/>
  <xacro:ultrasonic name="right" x="${us_side_x}" y="${-us_side_y}" h="${us_h}" yaw="${-pi / 2}"/>
  <xacro:ultrasonic name="rear" x="${us_rear_x}" y="0" h="${us_h}" yaw="${pi}"/>

  <link name="gripper_link">
    <visual>
      <geometry><box size="0.06 0.125 0.04"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="gripper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gripper_link"/>
    <origin xyz="${gripper_x} 0 ${gripper_h - wheel_radius}"/>
  </joint>

</robot>
